{
  "manifest_version": 3,
  "name": "HM Moodle Cookie-Sync",
  "version": "1.0.0",
  "description": "Überträgt die Moodle-Session der HM automatisch an deinen Moodle-Connector für Claude.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://moodle.hm.edu/*", "https://*.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "HM Moodle Cookie-Sync" }
}
